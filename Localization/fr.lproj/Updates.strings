/* Cocaine — updates and signature (fr) */

"Updates" = "Mises à jour";
"Check for updates automatically" = "Rechercher les mises à jour automatiquement";
"Once a day. Nothing is downloaded until you press Install." = "Une fois par jour. Rien n'est téléchargé tant que vous n'appuyez pas sur Installer.";
"Check now" = "Vérifier";
"Install" = "Installer";
"Download" = "Télécharger";
"Retry" = "Réessayer";
"Cancel" = "Annuler";
"Copy command" = "Copier la commande";
