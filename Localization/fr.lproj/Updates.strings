"Version %@: this build can't verify updates; download it from GitHub" = "Version %@ : cette version ne peut pas vérifier les mises à jour ; téléchargez-la sur GitHub";
"Version %@: this build is signed ad hoc; download it from GitHub" = "Version %@ : cette version est signée ad hoc ; téléchargez-la sur GitHub";
