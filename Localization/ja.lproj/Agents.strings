"Session open" = "セッション開始";
"Processing" = "処理中";
"Response completed" = "応答完了";
"Activity ended" = "活動終了";
"Open the session" = "セッションを開く";
"Supported" = "対応";
"Partial" = "一部対応";
"Not possible" = "不可";
"Unverified" = "未確認";
