/* Cocaine — updates and signature (ja) */

"Updates" = "アップデート";
"Check for updates automatically" = "アップデートを自動で確認";
"Once a day. Nothing is downloaded until you press Install." = "1日1回。「インストール」を押すまで何もダウンロードしません。";
"Check now" = "今すぐ確認";
"Install" = "インストール";
"Download" = "ダウンロード";
"Retry" = "再試行";
"Cancel" = "キャンセル";
"Copy command" = "コマンドをコピー";
"Not checked yet" = "まだ確認していません";
"Last checked %@" = "最終確認 %@";
"Checking…" = "確認中…";
"Cocaine is up to date" = "Cocaine は最新です";
"Version %@ is available" = "バージョン %@ が利用できます";
"Version %@: update with Homebrew (brew upgrade --cask cocaine)" = "バージョン %@：Homebrew でアップデートしてください（brew upgrade --cask cocaine）";
"Version %@: this build can't verify updates; download it from GitHub" = "バージョン %@：このビルドはアップデートを検証できません。GitHub からダウンロードしてください";
"Version %@: this build is signed ad hoc; download it from GitHub" = "バージョン %@：このビルドはアドホック署名です。GitHub からダウンロードしてください";
"Version %@: move Cocaine to Applications first" = "バージョン %@：先に Cocaine を「アプリケーション」に移動してください";
"Version %@: Cocaine's folder isn't writable; download it from GitHub" = "バージョン %@：Cocaine のフォルダに書き込めません。GitHub からダウンロードしてください";
"Downloading… %d%%" = "ダウンロード中… %d%%";
"Verifying and installing…" = "検証してインストール中…";
"You're offline." = "オフラインです。";
"Not enough disk space for the update." = "アップデートに必要なディスク容量が足りません。";
"The download didn't match the signed release and was deleted." = "ダウンロードが署名済みリリースと一致しなかったため削除しました。";
"Refused a download from outside GitHub." = "GitHub 以外からのダウンロードを拒否しました。";
"Couldn't reach GitHub. Try again later." = "GitHub に接続できません。後でもう一度お試しください。";
"The new version failed the authenticity check. Nothing was installed." = "新しいバージョンは真正性の確認に失敗しました。何もインストールしていません。";
"The release on GitHub isn't usable for an update." = "GitHub のリリースはアップデートに使用できません。";
"Cocaine can't write to its folder. Download the update from GitHub." = "Cocaine は自分のフォルダに書き込めません。GitHub からアップデートをダウンロードしてください。";
"The update couldn't be installed. Nothing was changed." = "アップデートをインストールできませんでした。何も変更していません。";
"This copy's signature can't be read." = "このコピーの署名を読み取れません。";
"Installed. Quit and reopen Cocaine to start the new version." = "インストールしました。Cocaine を終了して開き直すと新しいバージョンが起動します。";
"Signature: missing or damaged. Reinstall Cocaine." = "署名：ないか破損しています。Cocaine を再インストールしてください。";
"Signature: ad hoc. macOS forgets the permissions at every update." = "署名：アドホック。アップデートのたびに macOS が許可を忘れます。";
"Signature: self-signed, not verified by Apple. Permissions carry over only to updates signed with the same certificate." = "署名：自己署名（Apple の検証なし）。許可が引き継がれるのは同じ証明書で署名されたアップデートだけです。";
"Signature: a certificate that isn't Cocaine's or Apple's." = "署名：Cocaine のものでも Apple のものでもない証明書。";
"Signature: Developer ID, not notarized." = "署名：Developer ID（公証なし）。";
"Signature: Developer ID, notarized by Apple." = "署名：Developer ID（Apple の公証済み）。";
"Version %@ is signed with another certificate; download it from GitHub" = "バージョン %@ は別の証明書で署名されています。GitHub からダウンロードしてください";
"The new version didn't start, so the previous one was put back." = "新しいバージョンが起動しなかったため、以前のバージョンに戻しました。";
