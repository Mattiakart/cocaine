/* Cocaine — updates and signature (de) */

"Updates" = "Updates";
"Check for updates automatically" = "Automatisch nach Updates suchen";
"Once a day. Nothing is downloaded until you press Install." = "Einmal am Tag. Es wird nichts geladen, bevor du auf Installieren klickst.";
"Check now" = "Jetzt prüfen";
"Install" = "Installieren";
"Download" = "Laden";
"Retry" = "Erneut versuchen";
"Cancel" = "Abbrechen";
"Copy command" = "Befehl kopieren";
"Not checked yet" = "Noch nicht geprüft";
"Last checked %@" = "Zuletzt geprüft %@";
"Checking…" = "Wird geprüft …";
"Cocaine is up to date" = "Cocaine ist aktuell";
"Version %@ is available" = "Version %@ ist verfügbar";
"Version %@: update with Homebrew (brew upgrade --cask cocaine)" = "Version %@: mit Homebrew aktualisieren (brew upgrade --cask cocaine)";
"Version %@: this build can't verify updates; download it from GitHub" = "Version %@: Dieser Build kann Updates nicht prüfen; lade sie von GitHub";
"Version %@: this build is signed ad hoc; download it from GitHub" = "Version %@: Dieser Build ist ad hoc signiert; lade sie von GitHub";
"Version %@: move Cocaine to Applications first" = "Version %@: Bewege Cocaine zuerst in „Programme“";
"Version %@: Cocaine's folder isn't writable; download it from GitHub" = "Version %@: Der Ordner von Cocaine ist schreibgeschützt; lade sie von GitHub";
"Downloading… %d%%" = "Wird geladen … %d %%";
"Verifying and installing…" = "Wird geprüft und installiert …";
"You're offline." = "Du bist offline.";
"Not enough disk space for the update." = "Nicht genug Speicherplatz für das Update.";
"The download didn't match the signed release and was deleted." = "Der Download passte nicht zum signierten Release und wurde gelöscht.";
"Refused a download from outside GitHub." = "Download von außerhalb GitHub abgelehnt.";
"Couldn't reach GitHub. Try again later." = "GitHub ist nicht erreichbar. Versuche es später erneut.";
"The new version failed the authenticity check. Nothing was installed." = "Die neue Version hat die Echtheitsprüfung nicht bestanden. Es wurde nichts installiert.";
"The release on GitHub isn't usable for an update." = "Das Release auf GitHub ist für ein Update nicht verwendbar.";
"Cocaine can't write to its folder. Download the update from GitHub." = "Cocaine kann nicht in seinen Ordner schreiben. Lade das Update von GitHub.";
"The update couldn't be installed. Nothing was changed." = "Das Update konnte nicht installiert werden. Es wurde nichts verändert.";
"This copy's signature can't be read." = "Die Signatur dieser Kopie ist nicht lesbar.";
"Installed. Quit and reopen Cocaine to start the new version." = "Installiert. Beende Cocaine und öffne es erneut, um die neue Version zu starten.";
"Signature: missing or damaged. Reinstall Cocaine." = "Signatur: fehlt oder ist beschädigt. Installiere Cocaine neu.";
"Signature: ad hoc. macOS forgets the permissions at every update." = "Signatur: ad hoc. macOS vergisst die Berechtigungen bei jedem Update.";
"Signature: self-signed, not verified by Apple. Permissions carry over only to updates signed with the same certificate." = "Signatur: selbst signiert, nicht von Apple geprüft. Berechtigungen bleiben nur bei Updates mit demselben Zertifikat erhalten.";
"Signature: a certificate that isn't Cocaine's or Apple's." = "Signatur: ein Zertifikat, das weder von Cocaine noch von Apple ist.";
"Signature: Developer ID, not notarized." = "Signatur: Developer ID, nicht notarisiert.";
"Signature: Developer ID, notarized by Apple." = "Signatur: Developer ID, von Apple notarisiert.";
"Version %@ is signed with another certificate; download it from GitHub" = "Version %@ ist mit einem anderen Zertifikat signiert; lade sie von GitHub";
"The new version didn't start, so the previous one was put back." = "Die neue Version ist nicht gestartet, daher wurde die vorherige wiederhergestellt.";
