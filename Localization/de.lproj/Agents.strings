/* Cocaine — de: AI sessions (going back to them, requests answered from the notch) */

"Go to this session" = "Zu dieser Sitzung";
"Answer from the notch" = "In der Notch antworten";
"Claude Code and Codex: allow or deny a request (or answer an MCP question) from the notch. Nothing is ever allowed on its own: without an answer within 2 minutes the terminal asks as usual." = "Claude Code und Codex: eine Anfrage in der Notch erlauben oder ablehnen (oder eine MCP-Frage beantworten). Nichts wird je von selbst erlaubt: ohne Antwort innerhalb von 2 Minuten fragt wie gewohnt das Terminal.";
"asks you a question" = "stellt dir eine Frage";
"needs your approval" = "braucht deine Zustimmung";
"That request was no longer waiting: answer it in the terminal." = "Diese Anfrage wartete nicht mehr: beantworte sie im Terminal.";
"That request had expired: the terminal asks for it now." = "Diese Anfrage war abgelaufen: jetzt fragt das Terminal.";
"Cocaine doesn't know where this session runs (an older hook, or a script): look for it in your terminal." = "Cocaine weiß nicht, wo diese Sitzung läuft (ein alter Hook oder ein Skript): such sie in deinem Terminal.";
"Opened the project in %@ (its terminal panel can't be selected from outside)." = "Projekt in %@ geöffnet (sein Terminalbereich lässt sich von außen nicht auswählen).";
"Brought %@ forward. To select the exact tab, allow Cocaine to control %@ in Privacy & Security → Automation." = "%@ nach vorn geholt. Um den genauen Tab auszuwählen, erlaube Cocaine unter Datenschutz & Sicherheit → Automation, %@ zu steuern.";
"Brought %@ forward, but not the exact tab (it was closed, or %@ can't be steered from outside)." = "%@ nach vorn geholt, aber nicht der genaue Tab (er wurde geschlossen, oder %@ lässt sich von außen nicht steuern).";
"%@ isn't open any more: opened the session's folder in Finder." = "%@ ist nicht mehr offen: Ordner der Sitzung im Finder geöffnet.";
"The app this session ran in isn't open, and its folder is gone." = "Die App, in der diese Sitzung lief, ist nicht offen, und ihr Ordner existiert nicht mehr.";
"From before Cocaine restarted: not heard from since" = "Von vor dem Neustart von Cocaine: seitdem nichts gehört";
"Deny" = "Ablehnen";
"Decline" = "Ablehnen";
"Yes" = "Ja";
"No" = "Nein";
"%@ asks" = "%@ fragt";
"Wants to use %@" = "Will %@ verwenden";
"In the terminal" = "Im Terminal";
"Hands the request back to the terminal and goes there" = "Gibt die Anfrage ans Terminal zurück und geht dorthin";
