/* Cocaine — es: SSH hosts (AI agents on remote machines, through the user's own ssh) */

"A Host from ~/.ssh/config, or user@host (with :port if needed). Nothing is connected until you install the relay." = "Un Host de ~/.ssh/config, o usuario@host (con :puerto si hace falta). No se conecta nada hasta que instales el relay.";
