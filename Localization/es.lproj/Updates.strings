/* Cocaine — updates and signature (es) */

"Updates" = "Actualizaciones";
"Check for updates automatically" = "Buscar actualizaciones automáticamente";
"Once a day. Nothing is downloaded until you press Install." = "Una vez al día. No se descarga nada hasta que pulses Instalar.";
"Check now" = "Comprobar ahora";
"Install" = "Instalar";
"Download" = "Descargar";
"Retry" = "Reintentar";
"Cancel" = "Cancelar";
"Copy command" = "Copiar comando";
"Not checked yet" = "Aún no comprobado";
"Last checked %@" = "Última comprobación %@";
"Checking…" = "Comprobando…";
"Cocaine is up to date" = "Cocaine está actualizado";
"Version %@ is available" = "La versión %@ está disponible";
"Version %@: update with Homebrew (brew upgrade --cask cocaine)" = "Versión %@: actualiza con Homebrew (brew upgrade --cask cocaine)";
"Version %@: this build can't verify updates; download it from GitHub" = "Versión %@: esta compilación no puede verificar actualizaciones; descárgala de GitHub";
"Version %@: this build is signed ad hoc; download it from GitHub" = "Versión %@: esta compilación tiene firma ad hoc; descárgala de GitHub";
"Version %@: move Cocaine to Applications first" = "Versión %@: primero mueve Cocaine a Aplicaciones";
"Version %@: Cocaine's folder isn't writable; download it from GitHub" = "Versión %@: no se puede escribir en la carpeta de Cocaine; descárgala de GitHub";
"Downloading… %d%%" = "Descargando… %d%%";
"Verifying and installing…" = "Verificando e instalando…";
"You're offline." = "No tienes conexión.";
"Not enough disk space for the update." = "No hay espacio en disco suficiente para la actualización.";
"The download didn't match the signed release and was deleted." = "La descarga no coincidía con la versión firmada y se ha eliminado.";
"Refused a download from outside GitHub." = "Se rechazó una descarga ajena a GitHub.";
"Couldn't reach GitHub. Try again later." = "No se pudo conectar con GitHub. Inténtalo más tarde.";
"The new version failed the authenticity check. Nothing was installed." = "La nueva versión no superó la comprobación de autenticidad. No se instaló nada.";
"The release on GitHub isn't usable for an update." = "La versión publicada en GitHub no sirve para actualizar.";
"Cocaine can't write to its folder. Download the update from GitHub." = "Cocaine no puede escribir en su carpeta. Descarga la actualización de GitHub.";
"The update couldn't be installed. Nothing was changed." = "No se pudo instalar la actualización. No se cambió nada.";
"This copy's signature can't be read." = "No se puede leer la firma de esta copia.";
"Installed. Quit and reopen Cocaine to start the new version." = "Instalado. Sal de Cocaine y vuelve a abrirlo para iniciar la nueva versión.";
"Signature: missing or damaged. Reinstall Cocaine." = "Firma: ausente o dañada. Reinstala Cocaine.";
"Signature: ad hoc. macOS forgets the permissions at every update." = "Firma: ad hoc. macOS olvida los permisos en cada actualización.";
"Signature: self-signed, not verified by Apple. Permissions carry over only to updates signed with the same certificate." = "Firma: autofirmada, no verificada por Apple. Los permisos se conservan solo en actualizaciones firmadas con el mismo certificado.";
"Signature: a certificate that isn't Cocaine's or Apple's." = "Firma: un certificado que no es de Cocaine ni de Apple.";
"Signature: Developer ID, not notarized." = "Firma: Developer ID, sin notarizar.";
"Signature: Developer ID, notarized by Apple." = "Firma: Developer ID, notarizada por Apple.";
"Version %@ is signed with another certificate; download it from GitHub" = "La versión %@ está firmada con otro certificado; descárgala de GitHub";
"The new version didn't start, so the previous one was put back." = "La nueva versión no se inició, así que se restauró la anterior.";
