"Once a day. Nothing is downloaded until you press Install." = "Una volta al giorno. Non scarica nulla finché non premi Installa.";
"Check now" = "Controlla ora";
"Install" = "Installa";
"Download" = "Scarica";
"Retry" = "Riprova";
"Cancel" = "Annulla";
"Copy command" = "Copia comando";
"Not checked yet" = "Mai controllato";
