"Version %@: this build can't verify updates; download it from GitHub" = "Versione %@: questa build non può verificare gli aggiornamenti; scaricala da GitHub";
"Version %@: this build is signed ad hoc; download it from GitHub" = "Versione %@: questa build ha una firma ad hoc; scaricala da GitHub";
